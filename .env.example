# =============================================================================
# AI CUSTOMER SUPPORT SYSTEM - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your actual values

# -----------------------------------------------------------------------------
# FLASK APPLICATION SETTINGS
# -----------------------------------------------------------------------------
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-key

# -----------------------------------------------------------------------------
# AI/ML API KEYS (REQUIRED)
# -----------------------------------------------------------------------------
# Get your Groq API key from: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: OpenAI API key from: https://platform.openai.com/
OPENAI_API_KEY=sk-your_openai_api_key_here

# Optional: Hugging Face API key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///customer_support.db

# -----------------------------------------------------------------------------
# EMAIL INTEGRATION SETTINGS
# -----------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_USE_TLS=True
FROM_EMAIL=your-email@gmail.com
SUPPORT_EMAIL=support@yourcompany.com

# -----------------------------------------------------------------------------
# WHATSAPP INTEGRATION SETTINGS
# -----------------------------------------------------------------------------
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# -----------------------------------------------------------------------------
# WEB SCRAPING SETTINGS
# -----------------------------------------------------------------------------
MAX_PAGES_PER_SITE=50
SCRAPING_DELAY=1
REQUEST_TIMEOUT=30
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# -----------------------------------------------------------------------------
# AI MODEL SETTINGS
# -----------------------------------------------------------------------------
AI_MODEL=llama3-8b-8192
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_TOKENS=1000
TEMPERATURE=0.7
MAX_CONTEXT_LENGTH=4000
SIMILARITY_THRESHOLD=0.7
MAX_RELEVANT_CONTEXTS=3

# -----------------------------------------------------------------------------
# WEBHOOK SETTINGS
# -----------------------------------------------------------------------------
WEBHOOK_PORT=5001
WEBHOOK_HOST=0.0.0.0
WEBHOOK_URL=https://your-domain.com/webhook

# -----------------------------------------------------------------------------
# SECURITY SETTINGS
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRES=3600
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# -----------------------------------------------------------------------------
# LOGGING SETTINGS
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# -----------------------------------------------------------------------------
# STORAGE SETTINGS
# -----------------------------------------------------------------------------
SCRAPED_DATA_PATH=scraped_data
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_WHATSAPP=True
ENABLE_EMAIL=True
ENABLE_ANALYTICS=True
ENABLE_RATE_LIMITING=True
ENABLE_CACHING=True

# -----------------------------------------------------------------------------
# COMPANY SETTINGS
# -----------------------------------------------------------------------------
COMPANY_NAME=Your Company Name
COMPANY_WEBSITE=https://yourcompany.com
SUPPORT_HOURS=9 AM - 6 PM EST
DEFAULT_GREETING=Hello! How can I help you today?
DEFAULT_FALLBACK=I'm sorry, I don't have information about that. Let me connect you with a human agent.